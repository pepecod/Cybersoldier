[sub_resource type="GDScript" id="GDScript_w53o8"]
script/source = "extends ProyectilBase
class_name Perdigon

# Configuración específica
@export var dispersion_aleatoria: float = 0.1
@export var rebotes_maximos: int = 2

var rebotes_restantes: int

func _ready():
	rebotes_restantes = rebotes_maximos
	# Aplica dispersión inicial
	direccion = direccion.rotated(randf_range(-dispersion_aleatoria, dispersion_aleatoria))

func _on_body_entered(body):
	if body.has_method(\"recibir_dano\"):
		body.recibir_dano(daño)
	
	if rebotes_restantes > 0:
		rebotes_restantes -= 1
		# Lógica de rebote (simplificada)
		direccion = direccion.bounce(body.get_normal())
	else:
		destruir()
"

